{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "./custom-worker.ts",
	"name": "datara-website",
	"compatibility_date": "2026-07-17",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
        "keep_vars": true,
        "vars": {
                "DATARA_ENVIRONMENT": "production",
                "DATARA_EXPECTED_DATABASE_HOST": "ep-rapid-cherry-auerqx8r-pooler.c-10.us-east-1.aws.neon.tech",
                "DATARA_PUBLIC_URL": "https://datara-lab.com",
                "NEXT_PUBLIC_DATARA_ENVIRONMENT": "production"
        },
        "observability": {
                "enabled": true,
                "logs": {
                        "enabled": true,
                        "head_sampling_rate": 1,
                        "persist": true,
                        "invocation_logs": true
                },
                "traces": {
                        "enabled": false
                }
        },
	"minify": true,
	"triggers": {
		"crons": [
			"*/10 * * * *",
			"0 15 * * *"
		]
	},
	"routes": [
		{
			"pattern": "datara-lab.com",
			"custom_domain": true
		},
		{
			"pattern": "www.datara-lab.com",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "datara-website"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"r2_buckets": [
		{
			"bucket_name": "datara-crm-documents",
			"binding": "datara_crm_documents",
			"remote": false
		}
	]
}