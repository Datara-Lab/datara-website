{
  "name": "datara-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "build:demo": "opennextjs-cloudflare build --config=wrangler.demo.jsonc",
    "preview:demo": "opennextjs-cloudflare build --config=wrangler.demo.jsonc && opennextjs-cloudflare preview --config=wrangler.demo.jsonc",
    "deploy:demo": "opennextjs-cloudflare build --config=wrangler.demo.jsonc && opennextjs-cloudflare deploy --config=wrangler.demo.jsonc",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.20",
    "@neondatabase/serverless": "^1.1.0",
    "@onparallel/write-excel-file-data-validation": "^1.0.0",
    "@opennextjs/cloudflare": "^1.20.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.32.0",
    "next": "16.2.10",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "read-excel-file": "^9.3.10",
    "stripe": "^22.5.0",
    "tz-lookup": "^6.1.25",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/tz-lookup": "^6.1.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "wrangler": "^4.111.0"
  }
